# ==============================================================================
# URBAN SAFETY AI-SOC: NVIDIA NIM VLM CONFIGURATION
# ==============================================================================

# NVIDIA NIM API Key (Lấy từ https://build.nvidia.com/)
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA NIM API Endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA Multimodal Vision Model
# Các model thị giác được hỗ trợ:
# - meta/llama-3.2-11b-vision-instruct (Khuyên dùng)
# - meta/llama-3.2-90b-vision-instruct
# - nvidia/neva-22b
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

# Server Port (7777 for remote tunneling & HLS)
PORT=7777

# Timeout for AI analysis (NVIDIA NIM VLM) in seconds
NVIDIA_TIMEOUT_SECONDS=30.0

# Camera Configuration
CAMERA_ID=LAPTOP_01
ENABLE_NVIDIA_VLM=true
INCIDENT_MODEL_URL=https://urbanstrike.tech/api/incident
