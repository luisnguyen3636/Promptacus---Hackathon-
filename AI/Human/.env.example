# ==============================================================================
# URBAN SAFETY AI-SOC: OPENROUTER & NVIDIA VLM CONFIGURATION
# ==============================================================================

# Active VLM Provider: openrouter | nvidia
VLM_PROVIDER=openrouter

# OpenRouter Configuration (Primary Vision Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# NVIDIA NIM API Key & Config (Fallback)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

PORT=7777
NVIDIA_TIMEOUT_SECONDS=30.0
CAMERA_ID=LAPTOP_01
ENABLE_NVIDIA_VLM=true
INCIDENT_MODEL_URL=https://urbanstrike.tech/api/incident
